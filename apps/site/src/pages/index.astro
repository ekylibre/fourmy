---
import { getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import FeatureFigure from "../components/FeatureFigure.astro";
import { APP_URL } from "../lib/site";
import { captures } from "../lib/captures";
import { catalogue } from "../lib/catalogue";
import { release, formatDate } from "../lib/release";

const latest = release.entries.slice(0, 3);
// Rejeux 3D du haut de page (videos/accueil-rejeu), joués en alternance ; la première image de
// chacun sert d'affiche et, pour le premier, de repli.
const reels = [
  {
    src: "/videos/accueil-pulverisation",
    poster: await getImage({ src: captures.get("accueil-3d")!, width: 1600, format: "webp" }),
    label:
      "Rejeu 3D d'une pulvérisation : le tracteur et son pulvérisateur traitent une parcelle de maïs ; la bande traitée se colore derrière la rampe, qui se relève au bout du champ avant la passe suivante. En incrustation, la fiche de l'intervention : produit à 1,51 L/ha pour un maximum de 3 L/ha, IFT herbicides de 0,08, 25 °C et vent de 11 km/h, conditions moyennes ; la surface traitée qui passe de 2,2 à 2,8 ha sur les 9 ha du chantier ; la carte de la parcelle Sarthou avec les passes traitées ; chantier de 6 parcelles de maïs, Claas Arion 430 et Amazone UF1201, rampe de 18 m",
    caption:
      "Rejeu du 5 octobre 2026 de 16 h 46 à 16 h 50, accéléré dix fois, ferme de grandes cultures du Béarn. Un tracteur et son pulvérisateur de 18 m dans le maïs, d'après la trace GPS ; relief et photo aérienne IGN.",
  },
  {
    src: "/videos/accueil-broyage",
    poster: await getImage({ src: captures.get("accueil-broyage")!, width: 1600, format: "webp" }),
    label:
      "Rejeu 3D d'un broyage : le tracteur et son broyeur entrent dans une prairie permanente et y font leurs premières passes ; la bande broyée se colore derrière l'outil. En incrustation, la fiche de l'intervention : 16 °C et vent de 8 km/h, sans pluie, 1 h 38 de travail, contrôle réglementaire conforme, aucun produit appliqué ; la surface broyée qui passe de 0,01 à 0,04 ha sur les 0,43 ha de l'intervention ; la carte de la parcelle Monassut-Audiracq ; Claas Arion 430 et Maschio Tigre 300, broyeur de 2,8 m",
    caption:
      "Rejeu du 28 octobre 2026 de 14 h 07 à 14 h 10, accéléré dix fois, même ferme. Le même tracteur et un broyeur de 2,8 m dans une prairie permanente, d'après la trace GPS ; relief et photo aérienne IGN.",
  },
];

/** Les trois domaines de la page d'accueil : une capture, et ce que chacun couvre. */
const pillars = [
  {
    id: "interoperabilite",
    title: "Interopérabilité",
    text: "Fourmy lit ce que vos machines et vos capteurs savent déjà, et le range dans la ferme.",
    capture: "accueil-interoperabilite",
    alt: "Fiche d'une intervention : attelage tracteur et herse, parcours GPS rattaché, trace sur la photo aérienne",
    items: [
      ["GPS", "Les boîtiers des tracteurs découpent la journée en parcours, avec la surface travaillée, l'outil attelé et sa largeur ; deux clics en font une intervention."],
      ["Météo", "Chaque intervention garde sa météo, et le tableau de bord dit quand pulvériser. Open-Meteo, OpenWeather, meteoblue ; vos stations Weenat et Sencrop en test."],
      ["Isobus", "Cartes de modulation tirées du satellite, en ISO-XML ou Shapefile pour la console, ou envoyées par agrirouter (en test)."],
    ],
  },
  {
    id: "reglementaire",
    title: "Réglementaire",
    text: "Les contrôles se font à la saisie, et les registres se remplissent tout seuls.",
    capture: "accueil-reglementaire",
    alt: "Fiche d'un traitement : produits, pictogrammes, ZNT et délais, contrôle réglementaire des doses et des usages",
    items: [
      ["Dose et registre phyto", "Dose, usage autorisé, ZNT et délais vérifiés produit par produit ; registre phytosanitaire au format réglementaire 2027."],
      ["IFT", "Calculé pour chaque traitement par le service du ministère de l'Agriculture."],
      ["Plan de fumure", "Bilan azoté prévisionnel et cahier d'enregistrement en zone vulnérable nitrates."],
      ["PAC", "Îlots et parcelles du registre parcellaire graphique repris, actualisés d'un clic."],
    ],
  },
  {
    id: "parcellaire",
    title: "Parcellaire",
    text: "Chaque parcelle a son histoire : on la découpe sans perdre ce qui s'y est fait.",
    capture: "accueil-parcellaire",
    alt: "Fiche d'une parcelle de maïs sur la photo aérienne, avec ses onglets cultures, cadastre, eau, végétation, sol et météo",
    items: [
      ["Activités", "Une culture par parcelle et par campagne, qui règle les usages phyto, l'IFT et la fertilisation."],
      ["Découpe", "Découper, fusionner, dessiner : les surfaces restent justes et l'ancienne parcelle reste datée."],
      ["Zonage", "Zone réellement travaillée dessinée sur la carte, zones vulnérables, cours d'eau à proximité."],
      ["Cadastre", "Les parcelles cadastrales sous chaque parcelle culturale."],
      ["IGN", "Photo aérienne, carte, relief et bâtiments de la Géoplateforme de l'IGN."],
    ],
  },
] as const;
---

<Base title="Fourmy" description="Fourmy, le jumeau numérique de la ferme : parcelles, interventions, stocks, cuverie et traces GPS, à n'importe quelle date. Logiciel libre, nouvelle génération d'Ekylibre.">
  <section class="home-hero">
    <div class="wrap home-hero-head">
      <h1>Le jumeau numérique de votre ferme</h1>
      <p class="lead">
        Parcelles, interventions, stocks, cuves, tracteurs : Fourmy tient la ferme à jour, au champ comme au bureau, et vous
        laisse remonter le temps à n'importe quelle date.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/fonctionnalites/">Découvrir les fonctionnalités</a>
        <a class="btn btn-secondary" href="/contact/">Nous écrire</a>
      </div>
    </div>

    <figure class="field">
      <div class="field-frame">
        {
          reels.map((r, i) => (
            <video
              class="field-drone"
              autoplay={i === 0}
              muted
              loop={i === 0}
              playsinline
              preload={i === 0 ? "auto" : "none"}
              width="1600"
              height="900"
              poster={r.poster.src}
              aria-label={r.label}
              aria-hidden={i === 0 ? undefined : "true"}
              data-hero-video
              data-active={i === 0 ? "" : undefined}
            >
              <source src={`${r.src}.webm`} type="video/webm" />
              <source src={`${r.src}.mp4`} type="video/mp4" />
            </video>
          ))
        }
        <button class="field-toggle" type="button" data-hero-toggle aria-pressed="false">Mettre en pause</button>
      </div>
      <figcaption class="field-caption">
        {reels.map((r, i) => <span data-hero-caption hidden={i !== 0}>{r.caption}</span>)}
      </figcaption>
    </figure>

    <dl class="wrap facts">
      <div><dt>{catalogue.procedures}</dt><dd>procédures prêtes à saisir</dd></div>
      <div><dt>{catalogue.shapes.length}</dt><dd>formes d'intervention</dd></div>
      <div><dt>{release.version}</dt><dd>version actuelle</dd></div>
    </dl>
  </section>
  <script>
    // Haut de page : les rejeux jouent chacun une fois, à tour de rôle, en fondu (une seconde avant la
    // fin, ce qui saute le fondu de boucle de chaque fichier). Sans JavaScript, le premier boucle seul.
    // Arrêtés si l'on demande moins d'animations, et toujours suspendables (WCAG 2.2.2).
    const videos = [...document.querySelectorAll<HTMLVideoElement>("[data-hero-video]")];
    const captions = [...document.querySelectorAll<HTMLElement>("[data-hero-caption]")];
    const toggle = document.querySelector<HTMLButtonElement>("[data-hero-toggle]");
    if (videos.length && toggle) {
      let current = 0;
      let paused = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const show = () => {
        toggle.textContent = paused ? "Lire la vidéo" : "Mettre en pause";
        toggle.setAttribute("aria-pressed", String(paused));
      };
      const activate = (i: number) => {
        videos.forEach((v, k) => {
          v.toggleAttribute("data-active", k === i);
          if (k === i) v.removeAttribute("aria-hidden");
          else v.setAttribute("aria-hidden", "true");
        });
        captions.forEach((c, k) => (c.hidden = k !== i));
      };
      const next = () => {
        const from = videos[current];
        current = (current + 1) % videos.length;
        const to = videos[current];
        to.currentTime = 0;
        if (!paused) void to.play();
        activate(current);
        window.setTimeout(() => from.pause(), 1000);
      };
      videos.forEach((v, k) => {
        v.loop = videos.length === 1;
        v.addEventListener("timeupdate", () => {
          if (k === current && !paused && v.duration && v.currentTime >= v.duration - 1) next();
        });
      });
      // Le suivant se charge pendant que le premier joue.
      videos[0].addEventListener("playing", () => videos.slice(1).forEach((v) => (v.preload = "auto")), { once: true });
      if (paused) {
        videos[0].removeAttribute("autoplay");
        videos[0].pause();
      }
      show();
      toggle.addEventListener("click", () => {
        paused = !paused;
        if (paused) videos[current].pause();
        else void videos[current].play();
        show();
      });
    }
  </script>

  <section class="section wrap" aria-labelledby="deja">
    <h2 id="deja">Ce que Fourmy fait déjà</h2>
    {
      pillars.map((p) => (
        <article class="pillar" id={p.id} aria-labelledby={`${p.id}-titre`}>
          <FeatureFigure capture={p.capture} alt={p.alt} />
          <div class="pillar-text">
            <h3 id={`${p.id}-titre`}>{p.title}</h3>
            <p class="pillar-lead">{p.text}</p>
            <dl class="pillar-list">
              {p.items.map(([term, desc]) => (
                <div>
                  <dt>{term}</dt>
                  <dd>{desc}</dd>
                </div>
              ))}
            </dl>
          </div>
        </article>
      ))
    }
    <p class="pillar-more"><a href="/fonctionnalites/">Toutes les fonctionnalités, en images</a></p>
  </section>

  <section class="section wrap promises" aria-label="Nos engagements">
    <div>
      <h3>Nouvelle génération d'Ekylibre</h3>
      <p class="muted">
        Fourmy reprend Ekylibre, logiciel libre de gestion agricole développé depuis 2008, avec un modèle plus simple et vos
        données reprises telles quelles.
      </p>
    </div>
    <div>
      <h3>Libre et réversible</h3>
      <p class="muted">
        Code ouvert sous licence AGPL, données exportables : votre ferme ne dépend pas d'un éditeur. La comptabilité reste tenue
        dans <a href="https://lyvre.org/">Lyvre</a>.
      </p>
    </div>
    <div>
      <h3>Au champ, même sans réseau</h3>
      <p class="muted">L'application mobile enregistre hors ligne et envoie au retour de la connexion.</p>
    </div>
  </section>

  <section class="section wrap">
    <h2>Dernières nouveautés</h2>
    <ul class="news">
      {
        latest.map((e) => (
          <li>
            <strong>{e.text}</strong> <span class="muted">Version {e.version}, {formatDate(e.date)}.</span>
          </li>
        ))
      }
    </ul>
    <p><a href="/changelog/">Toutes les nouveautés</a> ou <a href={APP_URL}>se connecter à l'application</a>.</p>
  </section>
</Base>
