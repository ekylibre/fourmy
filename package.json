{
  "name": "fourmy",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "migrate": "turbo run migrate --filter=@fourmy/db",
    "dev": "turbo run dev"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "turbo": "2.3.3",
    "typescript": "5.7.3",
    "@eslint/js": "9.18.0",
    "eslint": "9.18.0",
    "typescript-eslint": "8.20.0",
    "eslint-plugin-react-hooks": "7.1.1"
  },
  "pnpm": {
    "overrides": {
      "@cesium/engine": "26.4.0",
      "@cesium/widgets": "16.3.0",
      "@cesium/core": "0.1.0"
    }
  },
  "//": "pnpm.overrides : cesium 1.146.0 déclare @cesium/engine ^26.4.0, mais engine 26.5.0 (publié avec cesium 1.147) retire des exports réexportés par 1.146 → build cassé. On fige les sous-paquets publiés avec 1.146 ; à retirer en passant à cesium ≥ 1.147."
}
