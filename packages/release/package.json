{
  "name": "@fourmy/release",
  "version": "0.0.0",
  "description": "Version, changelog public et garde-fou, calculés depuis l'historique Git (commits conventionnels)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "fourmy-release": "./dist/cli.js"
  },
  "files": [
    "dist",
    "denylist.txt",
    "public-overrides.json"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "devDependencies": {
    "vitest": "2.1.8"
  }
}
