# Base de données (développement)
DATABASE_URL=postgres://fourmy:fourmy@localhost:5432/fourmy

# API
PORT=3000

# Authentification (better-auth). Le secret signe les sessions : obligatoire
# (32 caractères au moins, ex. `openssl rand -base64 32`) dès que la base n'est
# pas locale ; en local, un secret de développement est utilisé à défaut.
BETTER_AUTH_SECRET=
# URL publique de l'API (cookies, liens) et origines du web autorisées.
BETTER_AUTH_URL=http://localhost:3000
FOURMY_TRUSTED_ORIGINS=
# Schéma d'URL de l'application mobile (en-tête Origin de zero-mobile).
FOURMY_MOBILE_ORIGINS=zeromobile://
# Inscription libre (désactivée : comptes créés par `pnpm --filter @fourmy/api user:create`).
FOURMY_ALLOW_SIGNUP=false

# Chiffrement des secrets d'intégration (jetons Traccar…), 32 octets base64 :
# `openssl rand -base64 32`. Requis hors développement local. Les accès Traccar
# se configurent par ferme dans l'interface (Intégrations), plus ici.
FOURMY_SECRETS_KEY=

# Outil d'administration seulement (connector-traccar, synchro manuelle) :
# TRACCAR_URL / TRACCAR_TOKEN

# IGN Géoplateforme (relief, BD TOPO) — ADR-9/10
IGN_GEOPLATEFORME_URL=https://data.geopf.fr

# Imports Ekylibre depuis l'API : serveur où sont restaurées les bases
# sources (ekylibre_src_<tenant>, cf. packages/migrator-ekylibre). Le client
# ne fournit qu'un nom de base, jamais une URL.
EKYLIBRE_SOURCES_URL=postgres://fourmy:fourmy@localhost:5432/

# Formulaire de contact du site fourmy.org (désactivé sans FOURMY_SMTP_HOST).
FOURMY_SMTP_HOST=
FOURMY_SMTP_PORT=587
FOURMY_SMTP_USER=
FOURMY_SMTP_PASSWORD=
# Expéditeur (adresse du domaine fourmy.org) et destinataire.
FOURMY_SMTP_FROM=site@fourmy.org
FOURMY_CONTACT_TO=contact@fourmy.org
# Proxys de confiance devant l'API pour l'adresse du visiteur (Traefik + nginx : 2).
FOURMY_TRUSTED_PROXY_HOPS=0

# agrirouter (cartes de modulation vers les machines, docs/modulation.md) :
# application Fourmy enregistrée dans le portail développeur agrirouter
# (Developer → Applications), client OAuth avec l'adresse de retour ci-dessous.
# Sans ces variables, la connexion agrirouter est désactivée.
AGRIROUTER_CLIENT_ID=
AGRIROUTER_CLIENT_SECRET=
AGRIROUTER_APPLICATION_ID=
AGRIROUTER_SOFTWARE_VERSION_ID=
# Page web de retour du consentement (identique à celle déclarée chez agrirouter).
AGRIROUTER_REDIRECT_URI=https://app.example.org/agrirouter/callback
# production (défaut) ou qa ; AGRIROUTER_API_URL / AGRIROUTER_AUTHORIZE_URL surchargent les adresses.
AGRIROUTER_ENVIRONMENT=production

# Applications OAuth déclarées d'avance (lot AM5, docs/acces-externes.md) : JSON,
# ex. [{"clientId":"aiffel","name":"Aiffel","redirectUris":["https://…/callback"],"clientSecret":"…"}]
FOURMY_OAUTH_CLIENTS=
